<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowAudioPlaybackCapture="true"
        android:label="AutoPr Keyboard Audio"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".AdbImeService"
            android:exported="true"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <service
            android:name=".AudioCaptureService"
            android:exported="true"
            android:foregroundServiceType="mediaProjection" />

        <receiver
            android:name=".AudioCommandReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.autopr.keyboardaudio.START_RECORD" />
                <action android:name="com.autopr.keyboardaudio.STOP_RECORD" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
